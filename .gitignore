# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Operating-system metadata
.DS_Store
Thumbs.db

# AI tools
.kilo/

# The complete FDP mirror can contain large or restricted files. Keep it out
# of Git, except for generated harmonization programs under FDP/.
/FDP/**
!/FDP/.gitkeep
!/FDP/**/
!/FDP/**/Programs/
!/FDP/**/Programs/**

# Never commit data or binary artifacts if they appear under the code mirror.
/FDP/**/*.dta
/FDP/**/*.csv
/FDP/**/*.rds
/FDP/**/*.rda
/FDP/**/*.RData
/FDP/**/*.sas7bdat
/FDP/**/*.xpt
/FDP/**/*.sav
/FDP/**/*.zsav
/FDP/**/*.xlsx
/FDP/**/*.xls
/FDP/**/*.parquet
/FDP/**/*.feather
/FDP/**/*.sqlite
/FDP/**/*.db
/FDP/**/*.zip
/FDP/**/*.gz
/FDP/**/*.bz2
/FDP/**/*.xz
/FDP/**/*.7z
/FDP/**/*.rar
/FDP/**/*.tar
/FDP/**/*.pdf
/FDP/**/*.png
/FDP/**/*.jpg
/FDP/**/*.jpeg
/FDP/**/*.gif
/FDP/**/*.bmp
/FDP/**/*.tif
/FDP/**/*.tiff
/FDP/**/*.doc
/FDP/**/*.docx
/FDP/**/*.ppt
/FDP/**/*.pptx
/FDP/**/*.odt
/FDP/**/*.ods
/FDP/**/*.md

# Default sync manifest when FDP_PATH points at this repository.
.fdp-sync-manifest.csv
